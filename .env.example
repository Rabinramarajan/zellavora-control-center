# Zellavora Control Center - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ========== APPLICATION ==========
NODE_ENV=development
APP_NAME=Zellavora Control Center
APP_VERSION=2.0.0
ENVIRONMENT=development

# ========== API CONFIGURATION ==========
VITE_API_URL=http://localhost:3000/api/v1
API_URL=http://localhost:3000/api/v1
API_TIMEOUT=30000

# ========== AUTHENTICATION ==========
JWT_SECRET=your_jwt_secret_min_32_chars_required
REFRESH_TOKEN_SECRET=your_refresh_secret_min_32_chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
AUTH_ENABLED=true

# ========== SUPABASE (Optional) ==========
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ========== DATABASE ==========
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zellavora
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=zellavora

# ========== REDIS ==========
REDIS_URL=redis://localhost:6379

# ========== FILE UPLOAD & STORAGE ==========
MAX_FILE_SIZE=52428800
ALLOWED_TYPES=image/jpeg,image/png,image/gif,video/mp4,application/pdf
STORAGE_TYPE=local
STORAGE_BUCKET=zcc-media
STORAGE_REGION=us-east-1

# AWS S3 (if using S3)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ========== SECURITY ==========
ENABLE_HTTPS=false
VITE_CORS_ORIGINS=http://localhost:3000,http://localhost:4200
CORS_CREDENTIALS=true

# ========== LOGGING ==========
LOG_LEVEL=debug
VITE_LOGGING_ENDPOINT=
SENTRY_DSN=

# ========== EXTERNAL SERVICES ==========
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ========== CACHE ==========
CACHE_ENABLED=true
CACHE_DURATION=3600000

# ========== FEATURE FLAGS ==========
FEATURE_PORTFOLIO=true
FEATURE_DASHBOARD=true
FEATURE_USERS=true
FEATURE_BLOG=true
FEATURE_MEDIA=true
FEATURE_ANALYTICS=true
