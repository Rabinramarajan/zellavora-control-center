# Zellavora Control Center - Environment Configuration Template
# Copy to .env.local, .env.staging, or .env.production and update values

# ============================================================================
# Application
# ============================================================================
NODE_ENV=development
APP_NAME=Zellavora Control Center
APP_VERSION=1.0.0

# ============================================================================
# Server Configuration
# ============================================================================
PORT=3000
HOST=localhost

# URLs
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zellavora

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# Redis Cache
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# Authentication & Security
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
REFRESH_TOKEN_EXPIRY=7d

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================================================
# Supabase Configuration
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# Email Configuration
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@zellavora.com

# SendGrid (Alternative to SMTP)
SENDGRID_API_KEY=

# ============================================================================
# File Storage (Supabase Storage)
# ============================================================================
STORAGE_BUCKET=zellavora-uploads
STORAGE_REGION=us-east-1

# ============================================================================
# Monitoring & Logging
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# Sentry Error Tracking
SENTRY_DSN=

# ============================================================================
# CORS & Security
# ============================================================================
CORS_ORIGIN=http://localhost:4200
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_MFA_ENABLED=true
FEATURE_SOCIAL_LOGIN_ENABLED=false
FEATURE_ADVANCED_ANALYTICS_ENABLED=true
FEATURE_REAL_TIME_NOTIFICATIONS=true

# ============================================================================
# Third-party Services
# ============================================================================
# Stripe (Payment Processing)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Slack Notifications
SLACK_WEBHOOK_URL=

# ============================================================================
# Development Only
# ============================================================================
DEBUG=false
PRETTY_LOGS=true
SEED_DATABASE=false

# ============================================================================
# Docker Compose
# ============================================================================
COMPOSE_PROJECT_NAME=zellavora
