# Zellavora Control Center - Environment Variables
# Copy this file to .env.local and fill in your values

# ===== SUPABASE =====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===== API =====
VITE_API_URL=http://localhost:3000/api/v1
API_SECRET_KEY=your_api_secret_key

# ===== AUTHENTICATION =====
JWT_SECRET=your_jwt_secret_min_32_chars_required
REFRESH_TOKEN_SECRET=your_refresh_secret_min_32_chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ===== STORAGE =====
STORAGE_BUCKET=zcc-media
STORAGE_REGION=us-east-1

# ===== CORS =====
VITE_CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ===== LOGGING =====
LOG_LEVEL=debug
VITE_LOGGING_ENDPOINT=

# ===== ENVIRONMENT =====
NODE_ENV=development
ENVIRONMENT=development
