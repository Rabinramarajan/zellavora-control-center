{
  "name": "zellavora-control-center",
  "version": "1.0.0",
  "description": "Enterprise CMS and Administration Platform",
  "license": "MIT",
  "author": "Zellavora",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd apps/zcc-frontend && npm run dev",
    "dev:backend": "cd apps/backend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd apps/zcc-frontend && npm run build",
    "build:backend": "cd apps/backend && npm run build",
    "test": "npm run test:frontend",
    "test:frontend": "cd apps/zcc-frontend && npm run test",
    "test:e2e": "cd apps/zcc-frontend && npm run test:e2e",
    "lint": "npm run lint:frontend",
    "lint:frontend": "cd apps/zcc-frontend && npm run lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,html,css,json,md}\"",
    "type-check": "npm run type-check:frontend && npm run type-check:backend",
    "db:migrate": "cd apps/backend && npm run db:migrate",
    "db:migrate:deploy": "cd apps/backend && npm run db:migrate:deploy",
    "db:migrate:status": "cd apps/backend && npm run db:migrate:status",
    "db:reset": "cd apps/backend && npm run db:reset",
    "db:seed": "cd apps/backend && npm run db:seed",
    "db:seed:freelancer": "cd apps/backend && npm run db:seed:freelancer",
    "analyze": "npm run build --prefix apps/zcc-frontend -- --stats-json",
    "type-check:frontend": "npm run type-check --prefix apps/zcc-frontend",
    "type-check:backend": "npm run typecheck --prefix apps/backend",
    "build:all": "npm run build:frontend && npm run build:backend",
    "test:backend": "npm run test --prefix apps/backend -- --runInBand",
    "test:all": "npm run test:frontend && npm run test:backend",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,html,css,json,md}\""
  },
  "workspaces": [
    "apps/zcc-frontend"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.0.3",
    "prisma": "^5.22.0",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
