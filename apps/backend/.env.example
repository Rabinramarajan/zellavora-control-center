# ============================================================================
# Zellavora Control Center - Backend Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control (add to .gitignore)
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
NODE_ENV=development
VITE_API_URL=http://localhost:3000/api/v1

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
VITE_CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
JWT_SECRET=dev_secret_jwt_key_change_in_production_min_32_chars_very_long
REFRESH_TOKEN_SECRET=dev_refresh_secret_key_change_in_production_min_32_chars_very_long
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Password & Session Security
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Encryption Key (use a 32+ character random string)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-32-character-minimum-encryption-key-here

# ============================================================================
# MULTI-TENANCY CONFIGURATION
# ============================================================================
ENABLE_MULTITENANCY=true
DEFAULT_TENANT_NAME=Default Organization
DEMO_MODE=false

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Email Provider: console | smtp | sendgrid
EMAIL_PROVIDER=console

# SMTP Configuration (if using SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@zellavora.com
SMTP_FROM_NAME=Zellavora Control Center

# SendGrid Configuration (if using SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@zellavora.com

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Login-specific rate limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
STORAGE_BUCKET=zcc-media
STORAGE_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=50

# ============================================================================
# AUDIT LOGGING
# ============================================================================
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_TWO_FACTOR=true
ENABLE_OAUTH=false
ENABLE_SAML=false
ENABLE_API_KEYS=true

# ============================================================================
# OAUTH PROVIDERS (if enabled)
# ============================================================================
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# REDIS CONFIGURATION (for caching & sessions)
# ============================================================================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=300

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
ENABLE_METRICS=false

# ============================================================================
# API VERSION
# ============================================================================
API_VERSION=v1
