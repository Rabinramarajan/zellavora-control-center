generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                       String                 @id @default(uuid()) @db.Uuid
  name                     String                 @map("name")
  legalName                String?                @map("legal_name")
  clientCode               String                 @unique @map("client_code")
  logoUrl                  String?                @map("logo_url")
  faviconUrl               String?                @map("favicon_url")
  industry                 String?                @map("industry")
  size                     String?                @map("size")
  website                  String?                @map("website")
  gstNumber                String?                @map("gst_number")
  taxNumber                String?                @map("tax_number")
  registrationNumber       String?                @map("registration_number")
  email                    String?                @map("email")
  phone                    String?                @map("phone")
  address                  String?                @map("address")
  city                     String?                @map("city")
  state                    String?                @map("state")
  country                  String?                @map("country")
  pincode                  String?                @map("pincode")
  plan                     String                 @default("free") @map("plan")
  enforce2fa               Boolean                @default(false) @map("enforce_2fa")
  allowedDomains           Json?                  @map("allowed_domains")
  isVerified               Boolean                @default(false) @map("is_verified")
  verifiedAt               DateTime?              @map("verified_at") @db.Timestamptz(6)
  registrationSource       String?                @map("registration_source")
  inviteCode               String?                @map("invite_code")
  useCases                 Json?                  @map("use_cases")
  primaryColor             String?                @map("primary_color")
  theme                    String                 @default("light") @map("theme")
  termsAccepted            Boolean                @default(false) @map("terms_accepted")
  termsAcceptedAt          DateTime?              @map("terms_accepted_at") @db.Timestamptz(6)
  privacyAccepted          Boolean                @default(false) @map("privacy_accepted")
  privacyAcceptedAt        DateTime?              @map("privacy_accepted_at") @db.Timestamptz(6)
  cookieAccepted           Boolean                @default(false) @map("cookie_accepted")
  cookieAcceptedAt         DateTime?              @map("cookie_accepted_at") @db.Timestamptz(6)
  marketingConsent         Boolean                @default(false) @map("marketing_consent")
  marketingConsentAt       DateTime?              @map("marketing_consent_at") @db.Timestamptz(6)
  status                   String                 @default("active") @map("status")
  isDeleted                Boolean                @default(false) @map("is_deleted")
  deletedAt                DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdBy                String?                @map("created_by") @db.Uuid
  updatedBy                String?                @map("updated_by") @db.Uuid
  deletedBy                String?                @map("deleted_by") @db.Uuid
  version                  Int                    @default(1)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  allowSelfRegistration    Boolean                @default(false) @map("allow_self_registration")
  /// RegistrationType names this organization accepts. Null means ORGANIZATION_MEMBER only.
  allowedRegistrationTypes Json?                  @map("allowed_registration_types")
  requireAdminApproval     Boolean                @default(true) @map("require_admin_approval")
  requireEmailVerification Boolean                @default(true) @map("require_email_verification")
  auditLogs                AuditLog[]
  branches                 Branch[]
  configurations           CommonConfiguration[]
  dailySheets              DailySheet[]
  departments              Department[]
  invitedUsers             Invitation[]
  mediaFiles               MediaFile[]
  monthlySheets            MonthlySheet[]
  notifications            Notification[]
  userTenants              UserTenant[]
  settings                 OrganizationSettings[]
  portfolioProjects        PortfolioProject[]
  projects                 Project[]
  teams                    Team[]
  timesheets               Timesheet[]
  userRequests             UserRequest[]
  workspaces               Workspace[]

  @@map("organizations")
}

model User {
  id                      String               @id @default(uuid()) @db.Uuid
  email                   String               @unique
  emailId                 String?              @unique @map("email_id")
  username                String?              @unique
  fullName                String               @map("full_name")
  firstName               String?              @map("first_name")
  lastName                String?              @map("last_name")
  displayName             String?              @map("display_name")
  avatarUrl               String?              @map("avatar_url")
  bio                     String?              @map("bio")
  headline                String?              @map("headline")
  mobile                  String?              @map("mobile")
  mobileVerified          Boolean              @default(false) @map("mobile_verified")
  department              String?              @map("department")
  jobTitle                String?              @map("job_title")
  status                  UserStatus           @default(ACTIVE) @map("status")
  country                 String?              @map("country")
  timezone                String?              @map("timezone")
  language                String               @default("en") @map("language")
  gender                  String?              @map("gender")
  passwordHash            String?              @map("password_hash")
  passwordChangedAt       DateTime?            @map("password_changed_at") @db.Timestamptz(6)
  role                    String               @default("user")
  tenantId                String?              @map("tenant_id") @db.Uuid
  enable2fa               Boolean              @default(false) @map("enable_two_factor_authentication")
  mfaEnabled              Boolean              @default(false) @map("mfa_enabled")
  mfaEnrolledAt           DateTime?            @map("mfa_enrolled_at") @db.Timestamptz(6)
  mfaMethod               String?              @map("mfa_method")
  mfaSecret               String?              @map("mfa_secret")
  recoveryCodes           Json?                @map("recovery_codes")
  otp                     String?
  isAccountLocked         Boolean              @default(false) @map("is_account_locked")
  lastLockedDate          DateTime?            @map("last_locked_date") @db.Timestamptz(6)
  failedLoginAttempts     Int                  @default(0) @map("failed_login_attempts")
  successfulLoginAttempts Int                  @default(0) @map("successful_login_attempts")
  currentLoginDatetime    DateTime?            @map("current_login_datetime") @db.Timestamptz(6)
  lastLoginDatetime       DateTime?            @map("last_login_datetime") @db.Timestamptz(6)
  defaultLandingPage      String?              @map("default_landing_page")
  passwordResetFlag       Boolean              @default(false) @map("password_reset_flag")
  emailVerified           Boolean              @default(false) @map("email_verified")
  emailVerifiedAt         DateTime?            @map("email_verified_at") @db.Timestamptz(6)
  keyToken                String?              @map("key_token")
  statusValue             String?              @map("status_value")
  statusDescription       String?              @map("status_description")
  termsAccepted           Boolean              @default(false) @map("terms_accepted")
  termsAcceptedAt         DateTime?            @map("terms_accepted_at") @db.Timestamptz(6)
  privacyAccepted         Boolean              @default(false) @map("privacy_accepted")
  privacyAcceptedAt       DateTime?            @map("privacy_accepted_at") @db.Timestamptz(6)
  securityAlerts          Boolean              @default(true) @map("security_alerts")
  marketingEmails         Boolean              @default(false) @map("marketing_emails")
  isDeleted               Boolean              @default(false) @map("is_deleted")
  deletedAt               DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdBy               String?              @map("created_by") @db.Uuid
  updatedBy               String?              @map("updated_by") @db.Uuid
  deletedBy               String?              @map("deleted_by") @db.Uuid
  version                 Int                  @default(1)
  msg                     String?
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  mfaLastUsedCounter      Int?                 @map("mfa_last_used_counter")
  employeeCode            String?              @unique @map("employee_code")
  userType                String?              @map("user_type")
  branchId                String?              @map("branch_id") @db.Uuid
  reportingManagerId      String?              @map("reporting_manager_id") @db.Uuid
  userNo                  Int                  @unique @default(autoincrement()) @map("user_no")
  middleName              String?              @map("middle_name")
  employmentType          String?              @map("employment_type")
  joiningDate             DateTime?            @map("joining_date") @db.Date
  company                 String?              @map("company")
  workLocation            String?              @map("work_location")
  costCenter              String?              @map("cost_center")
  assignedOfficerId       String?              @map("assigned_officer_id") @db.Uuid
  accessScope             String?              @map("access_scope")
  alternateEmail          String?              @map("alternate_email")
  alternateMobile         String?              @map("alternate_mobile")
  addressLine1            String?              @map("address_line1")
  addressLine2            String?              @map("address_line2")
  city                    String?              @map("city")
  state                   String?              @map("state")
  postalCode              String?              @map("postal_code")
  lockReason              String?              @map("lock_reason")
  /// Platform-level super admin: may oversee data across every organization (e.g. sessions).
  isPlatformAdmin         Boolean              @default(false) @map("is_platform_admin")
  endDate                 DateTime?            @map("end_date") @db.Date
  dateOfBirth             DateTime?            @map("date_of_birth") @db.Date
  fatherName              String?              @map("father_name")
  motherName              String?              @map("mother_name")
  maritalStatus           String?              @map("marital_status")
  spouseName              String?              @map("spouse_name")
  spouseDateOfBirth       DateTime?            @map("spouse_date_of_birth") @db.Date
  /// Null for accounts that predate self-registration types, and for users
  /// created by an administrator or an invitation rather than by registering.
  registrationType        RegistrationType?    @map("registration_type")
  auditLogs               AuditLog[]
  blogPosts               BlogPost[]           @relation("BlogPostAuthor")
  dailySheetApprovals     DailySheet[]         @relation("DailySheetApprover")
  dailySheets             DailySheet[]         @relation("DailySheetUser")
  invitedUsers            Invitation[]         @relation("InvitedBy")
  monthlySheetApprovals   MonthlySheet[]       @relation("MonthlySheetApprover")
  monthlySheets           MonthlySheet[]       @relation("MonthlySheetUser")
  notifications           Notification[]
  userTenants             UserTenant[]
  passwordHistory         PasswordHistory[]
  profiles                Profile?
  timesheetApprovals      Timesheet[]          @relation("ApprovedTimesheets")
  timesheets              Timesheet[]          @relation("TimesheetUser")
  emailLogs               UserEmailLog[]
  userGroups              UserGroup[]
  adminNotes              UserNote[]
  userRequestsBy          UserRequest[]        @relation("UserRequestRequester")
  userRequestsFor         UserRequest[]        @relation("UserRequestTarget")
  roleAssignments         UserRoleAssignment[]
  statusHistory           UserStatusHistory[]
  teams                   Team[]               @relation("TeamToUser")

  @@map("users")
}

model UserTenant {
  userId       String           @map("user_id") @db.Uuid
  tenantId     String           @map("organization_id") @db.Uuid
  role         OrganizationRole @default(member) @map("role")
  departmentId String?          @map("department_id") @db.Uuid
  isDefault    Boolean          @default(false) @map("is_default")
  joinedAt     DateTime?        @default(now()) @map("joined_at") @db.Timestamptz(6)
  department   Department?      @relation(fields: [departmentId], references: [id])
  tenant       Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
  @@map("organization_members")
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  bio       String?
  headline  String?
  location  String?
  website   String?
  github    String?
  linkedin  String?
  twitter   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  code           String?
  isHeadOffice   Boolean      @default(false) @map("is_head_office")
  address        String?      @map("address")
  city           String?      @map("city")
  state          String?      @map("state")
  country        String?      @map("country")
  pincode        String?      @map("pincode")
  phone          String?      @map("phone")
  email          String?      @map("email")
  latitude       String?      @map("latitude")
  longitude      String?      @map("longitude")
  status         String       @default("active") @map("status")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  deletedBy      String?      @map("deleted_by") @db.Uuid
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  code           String?
  description    String?
  parentId       String?      @map("parent_id") @db.Uuid
  status         String       @default("active") @map("status")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  deletedBy      String?      @map("deleted_by") @db.Uuid
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
  userTenants    UserTenant[]

  @@index([organizationId])
  @@map("departments")
}

model Workspace {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  slug           String       @map("slug")
  description    String?
  settings       Json?        @map("settings")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  updatedBy      String?      @map("updated_by") @db.Uuid
  deletedBy      String?      @map("deleted_by") @db.Uuid
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model OrganizationSettings {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String
  value          String       @map("value")
  category       String?
  isEncrypted    Boolean      @default(false) @map("is_encrypted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("organization_settings")
}

model Invitation {
  id             String        @id @default(uuid()) @db.Uuid
  email          String
  code           String        @unique
  organizationId String?       @map("organization_id") @db.Uuid
  role           String        @default("employee") @map("role")
  departmentId   String?       @map("department_id") @db.Uuid
  invitedById    String?       @map("invited_by_id") @db.Uuid
  status         String        @default("pending") @map("status")
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?     @map("used_at") @db.Timestamptz(6)
  used           Boolean       @default(false)
  isDeleted      Boolean       @default(false) @map("is_deleted")
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  deletedBy      String?       @map("deleted_by") @db.Uuid
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  firstName      String?       @map("first_name")
  lastName       String?       @map("last_name")
  userId         String?       @map("user_id") @db.Uuid
  invitedBy      User?         @relation("InvitedBy", fields: [invitedById], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@map("invitations")
}

model Otp {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  target      String
  code        String
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  verified    Boolean  @default(false)
  attempts    Int      @default(0) @map("attempts")
  maxAttempts Int      @default(5) @map("max_attempts")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  userId      String?  @map("user_id") @db.Uuid
  sessionId   String?  @map("session_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([target])
  @@index([userId])
  @@map("otps")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_history")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  refreshToken   String?  @unique @map("refresh_token")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  deviceInfo     Json?    @map("device_info")
  isActive       Boolean  @default(true) @map("is_active")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  lastActivityAt DateTime @map("last_activity_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([organizationId])
  @@index([refreshToken])
  @@map("sessions")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  token          String    @unique
  userId         String    @map("user_id") @db.Uuid
  sessionId      String?   @map("session_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  isRevoked      Boolean   @default(false) @map("is_revoked")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  token      String    @unique
  userId     String?   @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@index([token])
  @@map("email_verifications")
}

model MobileVerification {
  id          String    @id @default(uuid()) @db.Uuid
  mobile      String    @unique
  countryCode String    @map("country_code")
  otpHash     String    @map("otp_hash")
  userId      String?   @map("user_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  verified    Boolean   @default(false)
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("mobile_verifications")
}

model AuthChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  purpose        String
  userId         String    @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  method         String?
  payload        String?
  rememberMe     Boolean   @default(false) @map("remember_me")
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  token     String    @unique
  userId    String?   @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  used      Boolean   @default(false)
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@index([token])
  @@map("password_resets")
}

model RegistrationSession {
  id               String    @id @default(uuid()) @db.Uuid
  email            String
  emailVerified    Boolean   @default(false) @map("email_verified")
  mobile           String?   @map("mobile")
  mobileVerified   Boolean   @default(false) @map("mobile_verified")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  displayName      String?   @map("display_name")
  country          String?
  timezone         String?
  language         String?
  gender           String?
  organizationName String?   @map("organization_name")
  organizationCode String?   @map("organization_code")
  industry         String?
  size             String?
  website          String?
  gstNumber        String?   @map("gst_number")
  taxNumber        String?   @map("tax_number")
  logoUrl          String?   @map("logo_url")
  useCases         Json?     @map("use_cases")
  branchName       String?   @map("branch_name")
  branchCode       String?   @map("branch_code")
  branchAddress    String?   @map("branch_address")
  branchCity       String?   @map("branch_city")
  branchState      String?   @map("branch_state")
  branchCountry    String?   @map("branch_country")
  branchPincode    String?   @map("branch_pincode")
  passwordHash     String?   @map("password_hash")
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaMethod        String?   @map("mfa_method")
  mfaSecret        String?   @map("mfa_secret")
  termsAccepted    Boolean   @default(false) @map("terms_accepted")
  privacyAccepted  Boolean   @default(false) @map("privacy_accepted")
  cookieAccepted   Boolean   @default(false) @map("cookie_accepted")
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  status           String    @default("in_progress") @map("status")
