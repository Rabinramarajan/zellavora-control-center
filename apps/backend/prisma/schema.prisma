/// System-wide outbound email configuration.
///
/// Deliberately a singleton (enforced by `scope`, which is always 'SYSTEM'):
/// password-reset, OTP and invitation mail is sent from flows that have no
/// organization context, so a per-tenant row could not serve them. Secrets are
/// stored encrypted via EncryptionService and never leave the API in plaintext.
model EmailSetting {
  id             String    @id @default(uuid()) @db.Uuid
  /// Always 'SYSTEM'. Unique, so the table holds exactly one active row.
  scope          String    @unique @default("SYSTEM")
  provider       String    @default("console")
  smtpHost       String?   @map("smtp_host")
  smtpPort       Int?      @map("smtp_port")
  /// Implicit TLS (port 465). STARTTLS on 587 is negotiated regardless.
  smtpSecure     Boolean   @default(false) @map("smtp_secure")
  smtpUser       String?   @map("smtp_user")
  /// AES-256-GCM ciphertext — never returned by the API.
  smtpPassword   String?   @map("smtp_password")
  fromEmail      String?   @map("from_email")
  fromName       String?   @map("from_name")
  /// Result of the last "send test email" run, for the settings UI.
  lastTestedAt   DateTime? @map("last_tested_at") @db.Timestamptz(6)
  lastTestStatus String?   @map("last_test_status")
  lastTestError  String?   @map("last_test_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid

  @@map("email_settings")
}

